{
  "firestore": {
    "rules": "firestore.rules",
    "database": "(default)",
    "location": "africa-south1"
  },
  "auth": {
    "providers": { "emailPassword": true }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      "firestore.rules",
      "scripts/**",
      "**/.*",
      "**/.*/**"
    ],
    "cleanUrls": true,
    "trailingSlashBehavior": "REMOVE",
    "headers": [
      { "source": "**/*.@(webp|png|jpg|jpeg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
      { "source": "**/*.@(html)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
    ]
  }
}
